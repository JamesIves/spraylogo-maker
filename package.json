{
  "name": "@jamesives/spraylogo-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Convert images, GIFs and videos into sprays for Source (VTF) and GoldSrc (WAD) games, right in the browser.",
  "license": "UNLICENSED",
  "author": "James Ives <iam@jamesiv.es> (https://jamesiv.es)",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.1",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": "prettier --write"
  }
}
